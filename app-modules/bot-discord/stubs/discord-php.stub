<?php

namespace Discord\Helpers;

/**
 * @template T
 */
interface CollectionInterface
{
    /**
     * @return T|null
     */
    public function get(string $discrim, mixed $key);

    /**
     * @return T|null
     */
    public function find(callable $callback);

    /**
     * @return T|null
     */
    public function first();
}

