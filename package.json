{
    "name": "@he4rt/hub",
    "license": "MIT",
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "types": "php artisan typescript:transform",
        "routes": "php artisan wayfinder:generate --path=resources/js/wayfinder --with-form",
        "typecheck": "tsc --noEmit",
        "design:lint": "bunx @google/design.md lint DESIGN.md",
        "format": "prettier --write \"**/*.{js,ts,tsx,json,yml,md,css}\"",
        "prepare": "husky",
        "outdated": "npm-check-updates"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@inertiajs/react": "3.11.0",
        "@laravel/passkeys": "0.2.0",
        "@shadcn/react": "0.3.1",
        "@tanstack/react-table": "9.3.1",
        "class-variance-authority": "0.7.1",
        "cmdk": "1.1.1",
        "cn": "0.5.2",
        "date-fns": "4.4.0",
        "embla-carousel-react": "8.6.0",
        "input-otp": "1.5.0",
        "lucide-react": "1.70.0",
        "next-themes": "0.4.6",
        "react": "19.3.1",
        "react-day-picker": "10.0.2",
        "react-dom": "19.3.1",
        "react-resizable-panels": "4.21.0",
        "recharts": "3.8.0",
        "shadcn": "4.23.0",
        "shiki": "4.6.0",
        "sonner": "2.0.8",
        "tw-animate-css": "1.4.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "0.1.11",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "autoprefixer": "10.6.1",
        "concurrently": "10.0.6",
        "fontaine": "0.8.2",
        "husky": "9.1.7",
        "laravel-vite-plugin": "3.2.0",
        "lint-staged": "17.6.0",
        "npm-check-updates": "23.1.0",
        "prettier": "3.9.9",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,yml,md,css}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    }
}
