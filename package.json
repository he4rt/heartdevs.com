{
    "name": "@he4rt/he4rtdevs",
    "version": "3.0.0",
    "license": "MIT",
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"**/*.{js,ts,tsx,json,yml,md,css}\"",
        "prepare": "husky",
        "outdated": "npm-check-updates"
    },
    "devDependencies": {
        "@emnapi/core": "1.11.3",
        "@emnapi/runtime": "1.11.3",
        "@inertiajs/react": "3.11.0",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "concurrently": "10.0.6",
        "fontaine": "0.8.1",
        "husky": "9.1.7",
        "laravel-echo": "2.6.3",
        "laravel-vite-plugin": "3.2.1",
        "lint-staged": "17.6.0",
        "npm-check-updates": "23.1.1",
        "prettier": "3.9.10",
        "pusher-js": "8.6.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.5",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2",
        "vite": "8.3.6"
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,yml,md,css}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    }
}
