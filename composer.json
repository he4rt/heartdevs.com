{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "he4rt/hub",
    "type": "project",
    "description": "",
    "keywords": [
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "he4rt/identity": "^1.0.0",
        "he4rt/panel-admin": "^1.0.0",
        "he4rt/panel-app": "^1.0.0",
        "inertiajs/inertia-laravel": "^3.7.0",
        "internachi/modular": "^3.0.2",
        "laravel/fortify": "^1.42",
        "laravel/framework": "^13.35.0",
        "laravel/pennant": "^1.27.0",
        "laravel/socialite": "^5.32.0",
        "laravel/tinker": "^3.1.0",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "monicahq/laravel-cloudflare": "^4.1.0",
        "spatie/laravel-activitylog": "^5.1.5",
        "spatie/laravel-backup": "^10.4.0",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-medialibrary": "^11.23.13",
        "spatie/laravel-permission": "^8.5.0",
        "spatie/laravel-query-builder": "^7.3.9",
        "spatie/laravel-settings": "^3.10.2",
        "spatie/laravel-typescript-transformer": "^3.3.0",
        "symfony/yaml": "^8.1",
        "tpetry/laravel-postgresql-enhanced": "^3.11.0",
        "tpetry/laravel-query-expressions": "^1.6.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.5",
        "larastan/larastan": "^3.15.0",
        "laravel/boost": "^2.10.4",
        "laravel/mcp": "^1.2.0",
        "laravel/pail": "^1.3.0",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.3",
        "laravel/telescope": "^5.28.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-faker": "^5.0.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.3.1",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.5",
        "rector/rector": "^2.8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "He4rt\\Identity\\Tests\\": "app-modules/identity/tests/",
            "He4rt\\PanelAdmin\\Tests\\": "app-modules/panel-admin/tests/",
            "He4rt\\PanelApp\\Tests\\": "app-modules/panel-app/tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "bun install",
            "composer run-script post-root-package-install",
            "composer run-script key:generate",
            "composer run-script post-create-project-cmd",
            "@php artisan storage:link --ansi",
            "@php artisan modules:sync --no-phpunit --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite"
        ],
        "pint": "vendor/bin/pint --parallel",
        "test:pint": "vendor/bin/pint --test --parallel",
        "rector": "vendor/bin/rector",
        "test:rector": "vendor/bin/rector --dry-run",
        "phpstan": "vendor/bin/phpstan analyse --ansi --memory-limit=1G",
        "test:phpstan": "vendor/bin/phpstan analyse --ansi --memory-limit=1G",
        "test:unit": "vendor/bin/pest --compact --group=unit",
        "test:feature": "vendor/bin/pest --compact --group=feature",
        "test:arch": "vendor/bin/pest --compact --group=arch",
        "test:browser": "vendor/bin/pest --compact --group=browser",
        "test:cov": "vendor/bin/pest --compact --coverage",
        "check": [
            "@test:rector",
            "@test:pint",
            "@test:phpstan"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --compact"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan modules:sync --no-phpunit --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('.env.testing') || copy('.env.testing.example', '.env.testing');\""
        ],
        "key:generate": [
            "@php artisan key:generate --ansi",
            "@php artisan key:generate --ansi --env=testing"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar",
                "laravel/telescope",
                "spatie/laravel-backup"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "bump-after-update": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "abandoned": {
                "audit": "report"
            },
            "advisories": {
                "block": true
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
